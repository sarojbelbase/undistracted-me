---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wordmark from "../../components/Wordmark.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site.js";
import { alternatives } from "../../data/alternatives.js";

const title = "Compare Undistracted Me vs Every Alternative";
const description =
  "Undistracted Me vs Momentum, Tabliss, Bonjourr, BlockSite, StayFocusd, Forest, Start.me, Toby, Hamro Patro and Nepali Patro: free, open source, no account.";

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${site.url}/compare/#page`,
      url: `${site.url}/compare/`,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#app` },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: alternatives.map((a, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: a.name,
          url: `${site.url}/${a.slug}-alternative/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${site.url}/compare/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url },
        { "@type": "ListItem", position: 2, name: "Compare", item: `${site.url}/compare/` },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={`${site.url}/compare/`} graph={graph}>
  <header class="cmp-head">
    <a class="logo" href="/" aria-label="Undistracted Me: home"><Wordmark /></a>
    <a class="cmp-install" href={site.chromeUrl} rel="noopener" target="_blank">Install free</a>
  </header>

  <main id="main">
    <section class="cmp-hero">
      <div class="cmp-wrap">
        <p class="cmp-kicker">Comparisons</p>
        <h1>Undistracted Me vs the rest</h1>
        <p class="cmp-sub">
          One page to see how Undistracted Me compares to the new tabs, blockers and calendar apps people switch from.
        </p>
      </div>
    </section>

    <section class="cmp-list">
      <div class="cmp-wrap">
        <ul class="cmp-grid">
          {alternatives.map((a) => (
            <li>
              <a class="cmp-card" href={`/${a.slug}-alternative/`}>
                <span class="cmp-vs">vs</span>
                <strong>{a.name}</strong>
                <span class="cmp-sub2">{a.subline}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="cmp-say">
      <div class="cmp-wrap">
        <h2>What people say</h2>
        <div class="cmp-quotes">
          <blockquote>
            <p>"It's an amazing extension, you must try this."</p>
            <cite>Chrome Web Store review</cite>
          </blockquote>
          <blockquote>
            <p>"Nice extension, keep going brother."</p>
            <cite>Chrome Web Store review</cite>
          </blockquote>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .cmp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: calc(env(safe-area-inset-top, 0px) + 1rem) var(--pad);
    background: var(--cream) var(--tc);
    border-bottom: 1px solid rgba(11, 11, 11, 0.08);
  }
  .cmp-head .logo svg { height: 1.55rem; width: auto; display: block; }
  .cmp-install {
    background: var(--ink);
    color: var(--white);
    padding: 0.65rem 1rem;
    border-radius: 0.35rem;
    font: 600 0.95rem var(--sans);
    text-decoration: none;
    transition: background 0.3s, color 0.3s;
  }
  .cmp-install:hover { background: var(--sun); color: var(--ink); }
  .cmp-wrap { max-width: 72rem; margin: 0 auto; }

  .cmp-hero { padding: calc(var(--sec) * 1.1) var(--pad); background: var(--cream) var(--tc); }
  .cmp-kicker {
    font: 400 1.2rem/1 var(--caps);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0;
  }
  .cmp-hero h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); margin-top: 0.4rem; }
  .cmp-sub { max-width: 46rem; font-size: 1.15rem; color: #3d3d3a; margin-top: var(--s2); }

  .cmp-list { padding: var(--sec) var(--pad); background: var(--white) var(--tw); }
  .cmp-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--g); }
  .cmp-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid rgba(11, 11, 11, 0.12);
    border-radius: var(--r);
    background: var(--white);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.3s;
  }
  .cmp-card:hover { border-color: var(--sun); }
  .cmp-vs {
    font: 400 0.8rem/1 var(--caps);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .cmp-card strong { font-size: 1.35rem; }
  .cmp-sub2 { font-size: 0.98rem; color: #3d3d3a; }

  .cmp-say { padding: var(--sec) var(--pad); background: var(--cream) var(--tc); }
  .cmp-say h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0 0 var(--s3); }
  .cmp-quotes { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--g); }
  .cmp-quotes blockquote {
    margin: 0;
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid rgba(11, 11, 11, 0.12);
    border-radius: var(--r);
    background: var(--white);
  }
  .cmp-quotes blockquote p { margin: 0; font-size: 1.15rem; color: var(--ink); }
  .cmp-quotes cite { display: block; margin-top: 0.7rem; font: 500 0.8rem var(--mono); color: var(--mute); font-style: normal; }

  @media (max-width: 800px) {
    .cmp-grid { grid-template-columns: 1fr; }
    .cmp-quotes { grid-template-columns: 1fr; }
  }
</style>
