---
import Wordmark from "./Wordmark.astro";
import { site } from "../data/site.js";

// Anchor links (e.g. "#features") only resolve on the homepage. On any other
// page: /changelogs, the comparison pages, 404: point them at the homepage
// section instead, so "#supporters" becomes "/#supporters" and still lands.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const anchor = (href) => (isHome ? href : `/${href}`);

const cols = [
  {
    h: "Product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#themes", label: "Themes" },
      { href: "#focus", label: "Focus Mode" },
      { href: "#privacy", label: "Privacy" },
      { href: "#supporters", label: "Supporters" },
      { href: "#faq", label: "FAQ" },
      { href: "/changelogs/", label: "Changelog" },
      { href: "/blog/", label: "Blog" },
    ],
  },
  {
    h: "Install",
    links: [
      { href: site.chromeUrl, label: "Chrome Web Store", external: true },
      { href: site.firefoxUrl, label: "Firefox Add-ons", external: true },
      { href: site.webAppUrl, label: "Web app", external: true },
    ],
  },
  {
    h: "Links",
    links: [
      { href: "#support", label: "Support" },
      { href: site.formsUrl, label: "Report a bug", external: true },
      { href: site.formsUrl, label: "Suggest a feature", external: true },
      { href: site.url, label: "Website", external: true },
      { href: site.githubUrl, label: "GitHub", external: true },
    ],
  },
  {
    h: "Community",
    links: [
      { href: site.social.reddit, label: "Reddit (r/Nepal)", external: true },
      { href: site.social.linkedin[0], label: "LinkedIn · launch", external: true },
      { href: site.social.linkedin[1], label: "LinkedIn · Chrome Web Store", external: true },
      { href: site.social.linkedin[2], label: "LinkedIn · Firefox & Chrome", external: true },
    ],
  },
  {
    h: "Compare",
    links: [
      { href: "/compare/", label: "All comparisons" },
    ],
  },
];

// Directory & social-proof badges. Add more entries here (Product Hunt,
// Chrome Web Store, Firefox Add-ons, etc.) and they join the same quiet row.
const badges = [
  {
    href: "https://alternativeto.net/software/undistracted-me/about/?utm_source=badge&utm_medium=referral",
    src: "https://alternativeto.net/static/badges/badge-compact-light.svg",
    alt: "Undistracted Me on AlternativeTo",
    width: 171,
    height: 58,
  },
  {
    href: "https://www.producthunt.com/products/undistracted-me?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-undistracted-me",
    src: "https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1325369&theme=light&t=1795287198578",
    alt: "Undistracted Me - A free, open-source new tab that blocks noise & keeps focus. | Product Hunt",
    width: 250,
    height: 54,
  },
  {
    href: "https://www.uneed.best/tool/undistracted-me",
    src: "https://www.uneed.best/EMBED3.png",
    alt: "Launching Soon on Uneed",
    width: 250,
    height: 65,
  },
];
---

<footer class="dark foot">
  <div>
    <a class="logo" href={anchor("#top")} aria-label="Undistracted Me: home"><Wordmark /></a>
    <p>Your new tab, minus the noise. A calm dashboard with Focus Mode, quiet widgets and everything you need in one place.</p>
  </div>

  {cols.map((col) => (
    <div>
      <h3>{col.h}</h3>
      {col.links.map((l) => (
        <a href={l.href.startsWith("#") ? anchor(l.href) : l.href} rel={l.external ? "noopener" : undefined} target={l.external ? "_blank" : undefined}>{l.label}</a>
      ))}
    </div>
  ))}

  <div class="foot-base">
    <p class="legal">Made with ♥ in Nepal. © 2026 Undistracted Me. MIT license.</p>
    <div class="foot-badges">
      {badges.map((b) => (
        <a class="fbadge" href={b.href} target="_blank" rel="noopener" aria-label={b.alt}>
          <img src={b.src} alt="" width={b.width} height={b.height} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </div>
</footer>
