---
import { features } from "../data/features.js";
---

<section class="section features" id="features">
  <div class="container">
    <header class="section-head">
      <p class="kicker">Everything in one quiet place</p>
      <h2 class="section-title">A dashboard that works <em>with</em> your focus, not against it.</h2>
      <p class="section-lede">Every widget is optional, rearrangeable, and tuned to be glanced at — never to pull you in.</p>
    </header>

    <div class="feature-index">
      {features.map((f) => (
        <article class="feature-entry">
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-text">{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
