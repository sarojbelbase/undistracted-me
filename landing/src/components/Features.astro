---
const features = [
  {
    title: "Nepali date & calendar",
    text: "Today's date in both the Bikram Sambat and Gregorian calendars, with festivals and occasions woven in.",
  },
  {
    title: "World clock & dual timezones",
    text: "A live clock with up to two extra timezones — keep Kathmandu and New York in the same glance.",
  },
  {
    title: "Widget dashboard",
    text: "A flexible grid of at-a-glance widgets: clock, notes, events, weather, stocks, Spotify, RSS, and more.",
  },
  {
    title: "Focus Mode",
    text: "One keystroke to a fullscreen zen view. Just you and the task in front of you.",
  },
  {
    title: "Ambient rain & white noise",
    text: "Optional rain and white-noise audio that fades in for deep work, and out when the timer ends.",
  },
  {
    title: "Paper, Glass & Comic themes",
    text: "Three hand-tuned widget surfaces, plus a sunrise-to-sunset auto theme that follows your day.",
  },
  {
    title: "LookAway breaks",
    text: "Gentle eye-break reminders that nudge you to blink, stretch, and reset — on your schedule.",
  },
  {
    title: "Google integrations",
    text: "Calendar, Tasks, and Contacts. Birthdays, anniversaries, and events, synced quietly.",
  },
  {
    title: "Website blocker",
    text: "Quiet the sites that pull you away the moment you need depth.",
  },
  {
    title: "Privacy-first & sync",
    text: "No account required, tokens stay on your device — and your dashboard follows you across machines.",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <header class="section-head">
      <p class="kicker">Everything in one quiet place</p>
      <h2 class="section-title">A dashboard that works <em>with</em> your focus, not against it.</h2>
      <p class="section-lede">Every widget is optional, rearrangeable, and tuned to be glanced at — never to pull you in.</p>
    </header>

    <div class="feature-index">
      {features.map((f) => (
        <article class="feature-entry">
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-text">{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
