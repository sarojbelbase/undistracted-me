---
import { Image } from "astro:assets";
import BrowserIcon from "./BrowserIcon.astro";
import { site } from "../data/site.js";
import heroShot from "../assets/showcase/dashboard-paper.webp";
---

<section class="hero" id="top" aria-label="Introduction">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Free · Open source · Made in Nepal</p>
      <h1 class="hero-title">
        Your new tab,<br />
        <span class="hero-title-indent">minus the noise.</span>
      </h1>
      <p class="hero-sub">
        A calm dashboard with a Nepali calendar, focus tools, and quiet widgets — so you can begin each day with intention.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.chromeUrl} rel="noopener">
          <BrowserIcon name="chrome" />
          Add to Chrome
        </a>
        <a class="text-link" href={site.firefoxUrl} rel="noopener">
          <BrowserIcon name="firefox" />
          Get it for Firefox
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
      </div>

      <p class="hero-notes">
        <span>No account required</span><span class="dot" aria-hidden="true"></span><span>Works offline</span><span class="dot" aria-hidden="true"></span><span>MIT licensed</span>
      </p>
    </div>

    <div class="hero-visual">
      <figure class="hero-photo">
        <img
          src="/hero-1600.webp"
          srcset="/hero-960.webp 960w, /hero-1600.webp 1600w, /hero-2560.webp 2560w"
          sizes="(max-width: 960px) 100vw, 46vw"
          width="1600" height="1063"
          alt="Misty Himalayan mountain range at dawn, layered ridges above a valley of cloud."
          fetchpriority="high" decoding="async"
        />
      </figure>
      <figure class="hero-shot">
        <Image
          src={heroShot}
          alt="The Undistracted Me new-tab dashboard: a Nepali date, clock, notes, and a tidy grid of widgets."
          width={1440}
          height={900}
          loading="eager"
        />
      </figure>
    </div>
  </div>

  <div class="ridgeline" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" fill="none"><path d="M0 34 L120 30 L210 44 L330 26 L470 40 L610 20 L720 36 L860 24 L1000 42 L1140 28 L1270 40 L1440 30" stroke="currentColor" stroke-width="1.25"/></svg>
  </div>
</section>
