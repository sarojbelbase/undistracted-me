---
import BrowserIcon from "./BrowserIcon.astro";
import { site } from "../data/site.js";
---

<section class="cta-band" id="download">
  <div class="cta-bg" aria-hidden="true">
    <img src="/hero-1600.webp" alt="" width="1600" height="1063" loading="lazy" decoding="async" />
  </div>
  <div class="cta-veil" aria-hidden="true"></div>
  <div class="container cta-band-inner">
    <h2 class="section-title">Ready for a calmer new tab?</h2>
    <p class="section-lede">Install in seconds. Keep your focus for hours.</p>
    <div class="cta-actions">
      <a class="btn btn-light" href={site.chromeUrl} rel="noopener">
        <BrowserIcon name="chrome" />
        Add to Chrome
      </a>
      <a class="btn btn-outline-invert" href={site.firefoxUrl} rel="noopener">
        <BrowserIcon name="firefox" />
        Get it for Firefox
      </a>
    </div>
    <p class="cta-meta">
      Free forever · MIT license · Works offline ·
      <a class="text-link text-link--light" style="display:inline;margin-left:6px" href={site.webAppUrl} rel="noopener">or try the web app</a>
    </p>
  </div>
</section>
