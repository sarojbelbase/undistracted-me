---
import speak from "../assets/design/speak.webp";
import { site } from "../data/site.js";

const points = [
  { b: "No account required", t: "Install and go. Everything works without ever signing in." },
  { b: "Tokens stored locally", t: "Google integrations store your tokens on your device, not on a server." },
  { b: "Minimal permissions", t: "We only ask for what each feature genuinely needs, and nothing more." },
  { b: "Open source", t: "Read every line on GitHub. There are no surprises because there's nothing hidden." },
];
---

<section class="sec dark two priv" id="privacy">
  <img class="priv-img" src={speak.src} width={speak.width} height={speak.height} alt="A person speaking." loading="lazy" decoding="async" />
  <div>
    <h2>Your new tab is nobody's business.</h2>
    <p>Undistracted Me is built to be quiet about your data. There's no account to create, no tracking to opt out of, and no analytics watching over your shoulder.</p>
    <ul>
      {points.map((p) => (
        <li><b>{p.b}</b>{p.t}</li>
      ))}
    </ul>
    <a class="alt" href={site.privacyUrl}>Read the privacy policy and terms</a>
  </div>
</section>
