---
import closeSilhouette from "../assets/design/close-silhouette.webp";
---

<section class="sec white close">
  <div class="close-grid">
    <div class="close-t">
      <h2>Open a tab. Feel lighter.</h2>
      <p>Free, local and quiet. Everything you need in one place, and nothing to get lost in.</p>
      <a class="alt" href="#top">Back to top</a>
    </div>
    <img
      src={closeSilhouette.src}
      width={closeSilhouette.width}
      height={closeSilhouette.height}
      alt="A silhouette of a person standing with arms wide open."
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
