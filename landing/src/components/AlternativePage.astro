---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sprite from "./Sprite.astro";
import Wordmark from "./Wordmark.astro";
import Footer from "./Footer.astro";
import { site } from "../data/site.js";
import { ours, getAlternative } from "../data/alternatives.js";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const alt = getAlternative(slug);
const canonical = `${site.url}/${slug}-alternative/`;

// Generic FAQ for comparison pages that don't define their own `faq`.
const defaultFaq = [
  {
    q: "Is Undistracted Me free?",
    a: "Yes. Undistracted Me is free and open source under the MIT license, with no account, no ads and no paid tier.",
  },
  {
    q: "Does Undistracted Me work offline?",
    a: "Yes. The clock, calendar and dashboard all work fully offline. Only optional widgets like weather and stocks need a connection.",
  },
  {
    q: "What makes Undistracted Me different?",
    a: "It's a focus new tab, not a single tool: a site blocker, Pomodoro timer, ambient sounds, Google Tasks and quiet widgets in one free, open-source package.",
  },
];

// Per-page JSON-LD: WebPage + BreadcrumbList (+ FAQPage when the entry defines
// `faq`). Nepali calendar/date terms are permitted here (JSON-LD) but never in
// visible body copy (rule #1).
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: alt.title,
      description: alt.description,
      inLanguage: "en",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#app` },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url },
        { "@type": "ListItem", position: 2, name: `${alt.name} alternative`, item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: (alt.faq ?? defaultFaq).map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};

const rows = [
  ["Price", alt.comparison.price, ours.price],
  ["Account needed", alt.comparison.account, ours.account],
  ["Open source", alt.comparison.openSource, ours.openSource],
  ["Pomodoro", alt.comparison.pomodoro, ours.pomodoro],
  ["Ambient sounds", alt.comparison.ambient, ours.ambient],
  ["Site blocking", alt.comparison.blocking, ours.blocking],
  ["Clip & save", alt.comparison.clipper, ours.clipper],
  ["Task integration", alt.comparison.tasks, ours.tasks],
  ["Widgets", alt.comparison.widgets, ours.widgets],
];
---

<BaseLayout
  title={alt.title}
  description={alt.description}
  canonical={canonical}
  graph={graph}
>
  <Sprite />

  <header class="alt-head">
    <a class="logo" href="/" aria-label="Undistracted Me: home"><Wordmark /></a>
    <a class="btn" href={site.chromeUrl} rel="noopener" target="_blank">
      <svg class="ic"><use href="#i-chrome" /></svg>
      <span>Add to Chrome</span>
    </a>
  </header>

  <main id="main">
    <section class="sec cream alt-hero">
      <div class="alt-wrap">
        <h1>{alt.h1}</h1>
        <p class="sublead">{alt.subline}</p>
        {alt.intro.map((p) => <p>{p}</p>)}
        <div class="cta">
          <a class="btn pulse" href={site.chromeUrl} rel="noopener" target="_blank">
            <svg class="ic"><use href="#i-chrome" /></svg>
            <span>Add to Chrome</span>
          </a>
          <a class="btn ghost" href={site.firefoxUrl} rel="noopener" target="_blank">
            <svg class="ic"><use href="#i-firefox" /></svg>
            <span>Get it for Firefox</span>
          </a>
        </div>
      </div>
    </section>

    <section class="sec white alt-cmp">
      <div class="alt-wrap">
        <h2>How {alt.name} and Undistracted Me compare</h2>
        <div class="table-wrap">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col"><span class="sr">Feature</span></th>
                <th scope="col">{alt.name}</th>
                <th scope="col">Undistracted Me</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(([label, them, us]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{them}</td>
                  <td class="us">{us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="sec cream alt-diff">
      <div class="alt-wrap">
        <h2>Where they differ</h2>
        {alt.differences.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="sec white alt-when">
      <div class="alt-wrap">
        <h2>When to choose {alt.name} instead</h2>
        <p class="when">{alt.whenToChoose}</p>
        <p class="meta">
          Comparison facts about {alt.name} are checked against its public site;
          everything about Undistracted Me reflects this repo as it stands today.
        </p>
      </div>
    </section>

    <section class="sec cream alt-cta">
      <div class="alt-wrap">
        <h2>A new tab that asks nothing of you.</h2>
        <p>Free, open source, no account. Focus Mode, Pomodoro, ambient sounds and quiet widgets: all built in.</p>
        <div class="cta">
          <a class="btn pulse" href={site.chromeUrl} rel="noopener" target="_blank">
            <svg class="ic"><use href="#i-chrome" /></svg>
            <span>Add to Chrome</span>
          </a>
          <a class="btn ghost" href="/" rel="noopener">
            <span>See the full tour</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
