---
import Seo from "@jdevalk/astro-seo-graph/Seo.astro";
import { site } from "../data/site.js";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  graph?: Record<string, unknown> | null;
  canonical?: string;
}

const {
  title = site.title,
  description = site.description,
  graph = null,
  canonical = site.url,
} = Astro.props;

const fontsUrl =
  "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Fraunces:ital,opsz,wght@1,9..144,500..800&family=Hanken+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap";

const verificationMeta = [
  ...(site.googleSiteVerification
    ? [{ name: "google-site-verification", content: site.googleSiteVerification }]
    : []),
  ...(site.bingSiteVerification
    ? [{ name: "msvalidate.01", content: site.bingSiteVerification }]
    : []),
];

// PostHog web analytics (replaces Umami). A no-op unless PUBLIC_POSTHOG_KEY is
// set; point it at the same PostHog project as the extension's VITE_POSTHOG_KEY
// for a single analytics dashboard.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";
const posthogAssetHost = posthogHost.replace(
  ".i.posthog.com",
  "-assets.i.posthog.com",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogType="website"
      ogImage={site.ogImage}
      ogImageAlt="Undistracted Me: a calm new tab dashboard with a Nepali calendar, Focus Mode and quiet widgets."
      ogImageWidth={1200}
      ogImageHeight={630}
      siteName={site.name}
      locale="en_US"
      twitter={{ card: "summary_large_image" }}
      graph={graph}
      extraLinks={[
        { rel: "icon", type: "image/png", href: "/favicon.png" },
        { rel: "apple-touch-icon", href: "/favicon.png" },
        { rel: "privacy-policy", href: site.privacyUrl },
        { rel: "preconnect", href: "https://fonts.googleapis.com" },
        { rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous" },
        ...(posthogKey
          ? [
              { rel: "preconnect", href: posthogAssetHost },
              { rel: "preconnect", href: posthogHost, crossorigin: "anonymous" },
            ]
          : []),
      ]}
      extraMeta={[
        ...verificationMeta,
        { name: "theme-color", content: "#f7f7f7" },
        { name: "color-scheme", content: "light" },
      ]}
    />

    <!-- Fonts: loaded non-blocking so first paint isn't held back by the
         Google Fonts round-trip; text renders in fallback then swaps in
         (display=swap). -->
    <link rel="stylesheet" href={fontsUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>

    {posthogKey && (
      <>
        <!-- PostHog Web Analytics (replaces Umami) -->
        <script is:inline define:vars={{ posthogKey, posthogHost }}>
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatureEnrollment onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
          posthog.init(posthogKey, { api_host: posthogHost });
        </script>

        <!-- Track every link & button click with a meaningful name so we can see
             what visitors do next: and, combined with UTM tags, which post sent
             them. One delegated listener covers every anchor and button. Prefers
             an explicit data-ph-event name, then the element's accessible label
             (aria-label, or visible text with screen-reader-only text stripped).
             No-op until PostHog loads. -->
        <script is:inline>
          function phEvent(name, data) {
            if (typeof window.posthog === "undefined" || typeof window.posthog.capture !== "function") return;
            window.posthog.capture(name, data);
          }
          function labelOf(el) {
            const aria = el.getAttribute("aria-label");
            if (aria) return aria.replace(/\s+/g, " ").trim();
            const clone = el.cloneNode(true);
            clone.querySelectorAll(".sr").forEach((n) => n.remove());
            return (clone.textContent || "").replace(/\s+/g, " ").trim();
          }
          document.addEventListener(
            "click",
            (e) => {
              const el = e.target.closest("a[href], button");
              if (!el) return;
              const name = (el.dataset.phEvent || labelOf(el)).slice(0, 80);
              if (!name) return;
              const url = el.getAttribute("href");
              phEvent(name, url ? { url } : undefined);
            },
            true,
          );
        </script>
      </>
    )}

    <script is:inline>
      // JS-gated reveal/motion: elements start hidden only when JS runs.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
