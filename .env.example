# ─── Vite build vars (VITE_* → bundled into the client) ─────────────────────────

# Shared secret for the backend API + curated photos (sent as X-Api-Key).
VITE_API_KEY=

# Google OAuth — ONE "Web application" client for the extension (Chrome, Brave,
# Edge, Opera, Vivaldi, Firefox) AND the website.
# Redirect URIs to register on this one client in Google Cloud Console:
#   https://app.undistracted.me/callbacks/auth.html
#   http://localhost:3000/callbacks/auth.html
#   http://localhost:5173/callbacks/auth.html
#   https://dbmaaolpghdcdcpjmjafjedomcclmbmn.chromiumapp.org/
#   https://2e81ac27e122df6c2f53ff217523926ae8d3563f.extensions.allizom.org/
#     ↑ Firefox: this is SHA-1("{1071d037-0f17-4c92-b06c-704050d2e2c3}"), NOT the raw
#       gecko id. Run `browser.identity.getRedirectURL()` to confirm before registering.
VITE_GOOGLE_CLIENT_ID=

# Spotify OAuth client ID.
VITE_SPOTIFY_CLIENT_ID=

# Cloudflare Web Analytics beacon token (web app; skipped when unset).
VITE_CF_BEACON_TOKEN=

# Optional overrides / flags:
VITE_DEBUG_MODE=          # "true" to enable debug overlays (e.g. Spotify mock)
VITE_WEBSITE_MODE=        # "true" for the hosted website; leave unset for the extension
VITE_PHOTOS_API_URL=      # Override curated photos endpoint (default: https://api.undistracted.me/photos/curated)
VITE_RAIN_API_URL=        # Override rain audio endpoint (default: https://api.undistracted.me/audio/rain)

# ─── Server-side (Cloudflare Pages Functions on api.undistracted.me — never bundled) ──

# Same value as VITE_GOOGLE_CLIENT_ID — used by auth/google/token.
GOOGLE_CLIENT_ID=
# "Web application" client secret — server-side only, never in the bundle.
GOOGLE_CLIENT_SECRET=
# Same value as VITE_API_KEY — used by Cloudflare Pages Functions (assertApiKey).
API_KEY=
