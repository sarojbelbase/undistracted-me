# Google OAuth — ONE "Web application" client for the extension (Chrome, Brave,
# Edge, Opera, Vivaldi, Firefox) AND the website. Public PKCE client — no secret.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth — secret for the website (server-side). Not used in the extension.
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Spotify OAuth client ID.
VITE_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Web Analytics beacon token (web app; skipped when unset).
VITE_CF_BEACON_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Debug overlays (Spotify mock, weather debug). Set "true" for local dev.
VITE_DEBUG_MODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firefox AMO (addons.mozilla.org) API credentials — from
# https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=user:xxxxxxxx:xxx
AMO_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
