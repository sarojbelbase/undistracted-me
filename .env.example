# ─── Vite / Extension build vars (VITE_ prefix → bundled into the client) ──────
# Required for both extension and website builds:
VITE_API_KEY=                # Shared secret: bundled into client (obfuscated via obscureEnvKeys plugin)

# Google OAuth — ONE "Web application" client handles the extension (Chrome, Brave,
# Edge, Opera, Vivaldi, Firefox) AND the website. Same client ID everywhere.
VITE_GOOGLE_CLIENT_ID=       # Google "Web application" OAuth client ID (XOR-encoded in bundle)
                             #   Redirect URIs to register on this one client:
                             #     https://app.undistracted.me/callbacks/auth.html          (website)
                             #     http://localhost:3000/callbacks/auth.html               (web dev)
                             #     http://localhost:5173/callbacks/auth.html               (web dev)
                             #     https://dbmaaolpghdcdcpjmjafjedomcclmbmn.chromiumapp.org/ (Chrome/Brave/Edge/…)
                             #     https://{1071d037-0f17-4c92-b06c-704050d2e2c3}.extensions.allizom.org/ (Firefox)
VITE_SPOTIFY_CLIENT_ID=      # Spotify OAuth client ID (XOR-encoded in bundle)
VITE_GITHUB_CLIENT_ID=       # GitHub OAuth client ID for cross-device sync (XOR-encoded in bundle)

# Optional overrides:
VITE_WEBSITE_MODE=           # Set to "true" for Vercel website deployment; leave unset for extension
VITE_DEBUG_MODE=             # Set to "true" to enable debug overlays (e.g. Spotify mock)
VITE_PHOTOS_API_URL=         # Override the curated photos endpoint (default: production URL)
VITE_CF_BEACON_TOKEN=        # Cloudflare Web Analytics beacon token (web app only; from Web Analytics → app.undistracted.me)

# ─── Server-side vars (process.env — never bundled into the client) ───
# IMPORTANT: GOOGLE_CLIENT_ID must be the SAME value as VITE_GOOGLE_CLIENT_ID.
# Both the extension and website exchange their PKCE authorization code through
# /api/auth/google/token, which holds the client_secret server-side only.
GOOGLE_CLIENT_ID=            # Google "Web application" OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=        # Google "Web application" OAuth client secret — server-side only, never in the bundle
API_KEY=                     # Same secret as VITE_API_KEY — used by Cloudflare Pages Functions (VITE_ vars are build-time only)
